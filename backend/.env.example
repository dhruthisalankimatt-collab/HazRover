# --- Chain ---
MST_RPC_URL=https://testnetrpc.mstblockchain.com
# Paste the MST testnet RPC URL from the MST docs / your wallet's network settings
MST_RPC_URL=
MST_CHAIN_ID=91562037
EXPLORER_BASE=https://testnet.mstscan.com

# --- Backend (operator) wallet: NEVER commit the real key ---
OPERATOR_PRIVATE_KEY=0x...
CONTRACT_ADDRESS=0x...

# Factory owner wallet(s) the watchdog should monitor (comma separated)
FACILITIES=0x...

# --- Device auth: same string goes in the ESP32 firmware (X-API-Key header) ---
DEVICE_API_KEY=pick-a-long-random-string

# --- Incident-log AI (runs only AFTER a slash): none | ollama | openai ---
LLM_PROVIDER=none
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

WATCHDOG_INTERVAL_S=60
